<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Stores the Item Type as a String, later to be used to concatenate to form the new Opportunity Name.</description>
        <name>Get_Item_Type</name>
        <label>Get Item Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>opptyItemType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.s7e__Item_Type__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity_Name</targetReference>
        </connector>
    </assignments>
    <description>Automatically names a NEW opportunity upon creation only as follows: “ShowCode - Account Name - Item Type”.</description>
    <environments>Default</environments>
    <formulas>
        <description>Creates “ShowCode - Account Name - Item Type” from a formula here.</description>
        <name>opptyName</name>
        <dataType>String</dataType>
        <expression>{!$Record.s7e__Show_Code__c} + &quot; - &quot; + {!$Record.Account.Name} + &quot; - &quot; + {!opptyItemType}</expression>
    </formulas>
    <interviewLabel>Update New Opportunity Name on Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update New Opportunity Name on Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Updates the Opportunity Name to “ShowCode - Account Name - Item Type”.</description>
        <name>Update_Opportunity_Name</name>
        <label>Update Opportunity Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>opptyName</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Item_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>s7e__Show_Code__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>s7e__Item_Type__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>opptyItemType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue></stringValue>
        </value>
    </variables>
</Flow>
