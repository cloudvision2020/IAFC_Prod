<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Draft/inactive manual screen flow for NERIS candidate acceptance. The flow is intentionally packaged as Draft: it sets Account.NERIS_Fire_Department__c from the candidate, warns before replacing existing links, and deletes candidate rows by looping over a fetched collection so zero candidates cannot fault.</description>
    <interviewLabel>Accept NERIS Match {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Accept NERIS Match</label>
    <loops>
        <name>Loop_Candidates_For_Cleanup</name>
        <label>Loop Candidates For Cleanup</label>
        <locationX>176</locationX>
        <locationY>900</locationY>
        <collectionReference>Get_Candidates_For_Cleanup</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Delete_Candidate_In_Loop</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordDeletes>
        <name>Delete_Candidate_In_Loop</name>
        <label>Delete Candidate In Loop</label>
        <locationX>176</locationX>
        <locationY>960</locationY>
        <connector>
            <targetReference>Loop_Candidates_For_Cleanup</targetReference>
        </connector>
        <inputReference>Loop_Candidates_For_Cleanup</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_Account</name>
        <label>Get Account</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Existing_Account_For_NERIS</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate.Candidate_Account__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Candidate</name>
        <label>Get Candidate</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Account</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>NERIS_Match_Candidate__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Candidates_For_Cleanup</name>
        <label>Get Candidates For Cleanup</label>
        <locationX>176</locationX>
        <locationY>840</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Candidates_For_Cleanup</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>Candidate_Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate.Candidate_Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>NERIS_Fire_Department__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate.NERIS_Fire_Department__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>NERIS_Match_Candidate__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Account_For_NERIS</name>
        <label>Get Existing Account For NERIS</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Confirm_Accept</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>NERIS_Fire_Department__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate.NERIS_Fire_Department__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Set_Account_NERIS_Link</name>
        <label>Set Account NERIS Link</label>
        <locationX>176</locationX>
        <locationY>720</locationY>
        <connector>
            <targetReference>Get_Candidates_For_Cleanup</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Candidate.Candidate_Account__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>NERIS_Fire_Department__c</field>
            <value>
                <elementReference>Get_Candidate.NERIS_Fire_Department__c</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <screens>
        <name>Confirm_Accept</name>
        <label>Confirm Accept</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Account_NERIS_Link</targetReference>
        </connector>
        <fields>
            <name>Review_Message</name>
            <fieldText>&lt;p&gt;Confirm that this candidate should link the Account to the NERIS Fire Department. If this Account or NERIS record is already linked elsewhere, stop and resolve that conflict before continuing unless you intentionally mean to replace the link.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Candidate</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
