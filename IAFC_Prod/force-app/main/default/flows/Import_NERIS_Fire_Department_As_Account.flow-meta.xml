        <locationX>440</locationX>
        <locationY>1440</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Create_Error_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;The Account was not created.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Salesforce rejected the create step. Common causes are Account duplicate rules, Account field validation, or state/country picklist values. No Account link was written by this flow attempt.&lt;/p&gt;&lt;p&gt;Error detail: {!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;If this is a duplicate-rule error, search Accounts by the NERIS department name and city/state, then use the existing Account/link process instead of creating a duplicate.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
