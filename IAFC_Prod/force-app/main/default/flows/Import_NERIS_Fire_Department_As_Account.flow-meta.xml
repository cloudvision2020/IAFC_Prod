        <locationX>440</locationX>
        <locationY>690</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Duplicate_Billing_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Possible duplicate Account found. No Account was created.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;The existing Account matches this NERIS department by name, billing city, and billing state.&lt;/p&gt;&lt;p&gt;Account: {!Find_Strong_Duplicate_Billing.Name}&lt;br/&gt;Account Id: {!Find_Strong_Duplicate_Billing.Id}&lt;br/&gt;Billing: {!Find_Strong_Duplicate_Billing.BillingCity}, {!Find_Strong_Duplicate_Billing.BillingStateCode}&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;/lightning/r/Account/{!Find_Strong_Duplicate_Billing.Id}/view&quot; target=&quot;_blank&quot;&gt;Open possible duplicate Account&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Review the existing Account. If it is correct, link it using the match-review/accept process or update the Account NERIS link intentionally. This import flow stops here to avoid creating a duplicate Account.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
