<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>formula_1</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.OrderApi__Expected_Amount__c}</expression>
        <scale>17</scale>
    </formulas>
    <formulas>
        <name>formula_2</name>
        <dataType>Number</dataType>
        <expression>{!$Record.OrderApi__Expected_Count__c}</expression>
        <scale>17</scale>
    </formulas>
    <interviewLabel>SetActualValuesForNonReceiptBatch {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SetActualValuesForNonReceiptBatch</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Actual_Amount_and_Count</name>
        <label>Update Actual Amount and Count</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderApi__Is_Closed__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>OrderApi__Actual_Amount__c</field>
            <value>
                <elementReference>formula_1</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OrderApi__Actual_Count__c</field>
            <value>
                <elementReference>formula_2</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Actual_Amount_and_Count</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Non_receipt_Batch__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>OrderApi__Batch__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
