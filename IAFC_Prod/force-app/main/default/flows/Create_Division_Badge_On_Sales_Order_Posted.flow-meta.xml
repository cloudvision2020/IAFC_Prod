IF(
  CONTAINS({!$Record.OrderApi__Sales_Order_Line__r.OrderApi__Price_Rule__r.Name}, &quot;Eastern&quot;), &quot;Eastern&quot;,
IF(
  CONTAINS({!$Record.OrderApi__Sales_Order_Line__r.OrderApi__Price_Rule__r.Name}, &quot;Western&quot;), &quot;Western&quot;,
