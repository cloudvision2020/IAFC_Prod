<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata" fqn="iAFC_AppLauncherLWC">
    <apiVersion>46.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>IAFC App launcher</masterLabel>
    <description>Display and launch featured apps from the community.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage,lightningCommunity__Default,lightning__AppPage">
            <property name="input" description="JSON items" label="JSON Input" type="string"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>